<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane" prefHeight="662.0" prefWidth="838.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.eletronica.controller.OrdemServicoController">
   <children>
      <VBox prefHeight="662.0" prefWidth="838.0" spacing="10.0">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <Label alignment="CENTER" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Ordem de Serviço" />
            <HBox prefHeight="36.0" prefWidth="748.0">
               <children>
                  <Label text="Pesquisar:" />
                  <TextField fx:id="txtBusca" prefHeight="23.0" prefWidth="294.0" promptText="Digite a descrição..." />
                  <Button fx:id="btnPesquisar" mnemonicParsing="false" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold;" text="Buscar" />
                  <Button fx:id="btnNovo" mnemonicParsing="false" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;" text="Novo" />
               </children>
            </HBox>
            <TableView fx:id="tblOrdens" prefHeight="155.0" prefWidth="748.0">
              <columns>
                <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                <TableColumn fx:id="colDescricao" prefWidth="250.0" text="Descrição" />
                  <TableColumn fx:id="colCliente" prefWidth="150.0" text="Cliente" />
                  <TableColumn fx:id="colStatus" prefWidth="100.0" text="Status" />
                  <TableColumn fx:id="colOrcamento" prefWidth="100.0" text="Orçamento" />
                  <TableColumn fx:id="colData" prefWidth="100.0" text="Data" />
              </columns>
            </TableView>
            <Separator prefWidth="200.0" />
            <Label style="-fx-font-weight: bold; -fx-font-size: 14px;" text="Dados da Ordem de Serviço" />
            <GridPane hgap="10.0" prefHeight="154.0" prefWidth="798.0" vgap="10.0">
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="148.0" minWidth="10.0" prefWidth="68.0" />
                  <ColumnConstraints hgrow="SOMETIMES" maxWidth="266.0" minWidth="10.0" prefWidth="248.0" />
                  <ColumnConstraints hgrow="SOMETIMES" maxWidth="172.0" minWidth="5.0" prefWidth="48.0" />
                <ColumnConstraints hgrow="SOMETIMES" maxWidth="353.0" minWidth="10.0" prefWidth="336.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints maxHeight="20.0" minHeight="0.0" prefHeight="0.0" vgrow="SOMETIMES" />
                  <RowConstraints maxHeight="20.0" minHeight="0.0" prefHeight="0.0" vgrow="SOMETIMES" />
                  <RowConstraints maxHeight="20.0" minHeight="0.0" prefHeight="0.0" vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                  <Label text="ID:" />
                  <TextField fx:id="txtId" editable="false" prefHeight="23.0" prefWidth="184.0" GridPane.columnIndex="1" />
                  <Label prefHeight="15.0" prefWidth="45.0" text="Status:" GridPane.columnIndex="2" />
                  <ComboBox fx:id="cbStatus" prefWidth="150.0" GridPane.columnIndex="3" />
                  <Label text="Cliente:" GridPane.rowIndex="1" />
                  <ComboBox fx:id="cbCliente" prefWidth="250.0" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="1" />
                  <Label text="Produto:" GridPane.rowIndex="2" />
                  <ComboBox fx:id="cbProduto" prefWidth="250.0" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="2" />
                  <Label text="Orçamento:" GridPane.rowIndex="3" />
                  <TextField fx:id="txtOrcamento" prefHeight="39.0" prefWidth="265.0" GridPane.columnIndex="1" GridPane.rowIndex="3" />

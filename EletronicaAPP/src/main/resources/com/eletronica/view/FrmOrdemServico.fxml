                  <TextArea fx:id="txtDescricao" prefHeight="80.0" prefWidth="400.0" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="4" />
               </children>
            </GridPane>
            <HBox alignment="CENTER" prefHeight="34.0" prefWidth="748.0" spacing="10.0">
               <children>
                  <Button fx:id="btnSalvar" mnemonicParsing="false" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;" text="Salvar" />
                  <Button fx:id="btnLimpar" mnemonicParsing="false" style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-weight: bold;" text="Limpar" />
                  <Button fx:id="btnDeletar" mnemonicParsing="false" style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-font-weight: bold;" text="Deletar" />
               </children>
            </HBox>
            <TextArea fx:id="txtResultado" editable="false" minHeight="60.0" prefHeight="111.0" promptText="Resultado das operações..." />
         </children>
      </VBox>
   </children>
</AnchorPane>

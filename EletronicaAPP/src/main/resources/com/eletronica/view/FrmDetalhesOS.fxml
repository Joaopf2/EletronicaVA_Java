<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<AnchorPane id="AnchorPane" prefHeight="700.0" prefWidth="960.0" styleClass="dashboard-root" stylesheets="@style.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.eletronica.controller.DetalhesOSController">
   <children>
      <VBox spacing="16.0" styleClass="main-container"
            AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
            AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <!-- Cabeçalho -->
            <HBox alignment="CENTER_LEFT" spacing="14.0">
               <children>
                  <VBox styleClass="icon-box-blue">
                     <children>
                        <SVGPath content="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" fill="white" scaleX="1.1" scaleY="1.1" />
                     </children>
                  </VBox>
                  <VBox>
                     <children>
                        <Label fx:id="lblNumeroOS" styleClass="page-title" text="Consulta de Ordem de Serviço" />
                        <Label fx:id="lblDataAbertura" styleClass="page-subtitle" text="Visualização detalhada do atendimento e controle técnico" />
                     </children>
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <HBox alignment="CENTER_RIGHT" spacing="10.0">
                     <children>
                        <Label fx:id="lblStatusBadge" styleClass="badge-espera" text="EM ESPERA" />
                        <VBox alignment="CENTER_RIGHT">
                           <children>
                              <Label style="-fx-font-size: 10.5px; -fx-text-fill: #94a3b8;" text="Responsável:" />
                              <Label fx:id="lblResponsavel" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #60a5fa;" text="-" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </children>
            </HBox>

            <!-- Grid com 2 Cards de Informação -->
            <HBox spacing="16.0" VBox.vgrow="ALWAYS">
               <children>
                  <!-- Card 1: Informações do Cliente & Equipamento -->
                  <VBox prefWidth="440.0" spacing="14.0" styleClass="card-pane" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="section-title" text="Dados do Cliente" />
                        <GridPane hgap="10.0" vgap="8.0">
                           <columnConstraints>
                              <ColumnConstraints halignment="RIGHT" minWidth="85.0" prefWidth="95.0" />
                              <ColumnConstraints hgrow="ALWAYS" minWidth="150.0" />
                           </columnConstraints>
                           <rowConstraints>
                              <RowConstraints minHeight="24.0" />
                              <RowConstraints minHeight="24.0" />
                              <RowConstraints minHeight="24.0" />
                              <RowConstraints minHeight="24.0" />
                           </rowConstraints>
                           <children>
                              <Label styleClass="detail-label" text="Nome:" />
                              <Label fx:id="lblClienteNome" styleClass="detail-value-bold" text="-" GridPane.columnIndex="1" />

                              <Label styleClass="detail-label" text="CPF / CNPJ:" GridPane.rowIndex="1" />
                              <Label fx:id="lblClienteCpf" styleClass="detail-value" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                              <Label styleClass="detail-label" text="Telefone:" GridPane.rowIndex="2" />
                              <Label fx:id="lblClienteTelefone" styleClass="detail-value" text="-" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                              <Label styleClass="detail-label" text="E-mail:" GridPane.rowIndex="3" />
                              <Label fx:id="lblClienteEmail" styleClass="detail-value" text="-" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                           </children>
                        </GridPane>

                        <Separator />

                        <Label styleClass="section-title" text="Dados do Equipamento" />
                        <GridPane hgap="10.0" vgap="8.0">
                           <columnConstraints>
                              <ColumnConstraints halignment="RIGHT" minWidth="85.0" prefWidth="95.0" />
                              <ColumnConstraints hgrow="ALWAYS" minWidth="150.0" />
                           </columnConstraints>
                           <rowConstraints>
                              <RowConstraints minHeight="24.0" />
                              <RowConstraints minHeight="24.0" />
                              <RowConstraints minHeight="24.0" />
                              <RowConstraints minHeight="24.0" />
                           </rowConstraints>
                           <children>
                              <Label styleClass="detail-label" text="Aparelho:" />
                              <Label fx:id="lblProdutoNome" styleClass="detail-value-bold" text="-" GridPane.columnIndex="1" />

                              <Label styleClass="detail-label" text="Marca/Mod:" GridPane.rowIndex="1" />
                              <Label fx:id="lblProdutoMarcaModelo" styleClass="detail-value" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                              <Label styleClass="detail-label" text="Tipo/Categ:" GridPane.rowIndex="2" />
                              <Label fx:id="lblProdutoTipoCategoria" styleClass="detail-value" text="-" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                              <Label styleClass="detail-label" text="Defeito Ini:" GridPane.rowIndex="3" />
                              <Label fx:id="lblProdutoDefeitoOriginal" styleClass="kpi-title-yellow" text="-" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                           </children>
                        </GridPane>
                     </children>
                  </VBox>

                  <!-- Card 2: Diagnóstico, Reparo e Orçamento -->
                  <VBox prefWidth="480.0" spacing="14.0" styleClass="card-pane" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="section-title" text="Diagnóstico &amp; Reparo Técnico" />

                        <Label styleClass="form-label" text="Descrição do Serviço / Diagnóstico:" />
                        <TextArea fx:id="txtDescricaoReparo" promptText="Diagnóstico detalhado, peças substituídas ou reparo efetuado..." wrapText="true" VBox.vgrow="ALWAYS" />

                        <GridPane hgap="12.0" vgap="12.0">
                           <columnConstraints>
                              <ColumnConstraints halignment="RIGHT" minWidth="90.0" prefWidth="100.0" />
                              <ColumnConstraints hgrow="ALWAYS" minWidth="150.0" />
                           </columnConstraints>
                           <rowConstraints>
                              <RowConstraints minHeight="36.0" />
                              <RowConstraints minHeight="36.0" />
                           </rowConstraints>
                           <children>
                              <Label styleClass="form-label" text="Orçamento (R$):" />
                              <TextField fx:id="txtOrcamento" promptText="0.00" GridPane.columnIndex="1" />

                              <Label styleClass="form-label" text="Alterar Status:" GridPane.rowIndex="1" />
                              <HBox alignment="CENTER_LEFT" spacing="8.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                 <children>
                                    <ComboBox fx:id="cbStatus" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                                    <Button fx:id="btnAvancarStatus" mnemonicParsing="false" styleClass="btn-warning" text="Avançar ❯" />
                                 </children>
                              </HBox>
                           </children>
                        </GridPane>
                     </children>
                  </VBox>
               </children>
            </HBox>

            <!-- Rodapé de Ações -->
            <VBox spacing="10.0" styleClass="card-pane">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="14.0">
                     <children>
                        <Button fx:id="btnSalvarAlteracoes" mnemonicParsing="false" prefHeight="40.0" prefWidth="170.0" styleClass="btn-primary" text="Salvar Alterações" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnExcluir" mnemonicParsing="false" prefHeight="40.0" prefWidth="130.0" styleClass="btn-danger" text="Excluir OS" />
                        <Button fx:id="btnFechar" mnemonicParsing="false" prefHeight="40.0" prefWidth="110.0" styleClass="btn-secondary" text="Fechar" />
                     </children>
                  </HBox>
               </children>
            </VBox>

            <!-- Status Log -->
            <TextArea fx:id="txtResultado" editable="false" maxHeight="45.0" minHeight="35.0" prefHeight="40.0" promptText="Resultado da consulta..." styleClass="status-log" />
         </children>
      </VBox>
   </children>
</AnchorPane>
